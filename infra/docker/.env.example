# ============================================================================
# COLHEITA — Local Docker Stack — Environment
# ============================================================================
# Copie pra .env (ao lado de docker-compose.yml) antes de rodar `pnpm infra:up`.
#
# IMPORTANTE: este arquivo configura APENAS a stack local de desenvolvimento.
# Os defaults abaixo são propositalmente identificáveis como dev-only —
# qualquer uso em produção é detectável e bloqueado pelo pre-flight check.
# Para produção, use Doppler ou variáveis de ambiente do provider.
# ============================================================================

# JWT — assinatura de tokens locais (mínimo 32 chars)
# Em produção: gerado pelo Supabase Cloud, rotacionado periodicamente.
LOCAL_JWT_SECRET=DEV_ONLY_jwt_secret_min_32_chars_replace_in_production

# Postgres — credenciais locais
# Em produção: managed pelo Supabase, sem acesso direto.
LOCAL_POSTGRES_PASSWORD=DEV_ONLY_postgres_password

# Anon key — JWT pré-assinado pra role anon
# Estes valores são os defaults documentados do Supabase local stack.
# Em produção: vêm do dashboard do Supabase.
LOCAL_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
LOCAL_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
