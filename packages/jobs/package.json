  "devDependencies": {
    "@colheita/config": "workspace:*",
    "tsx": "4.19.1",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "^5.6.0",
    "vitest": "2.1.4"
  }
