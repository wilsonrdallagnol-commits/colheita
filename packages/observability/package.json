{
  "name": "@colheita/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Wrappers de observabilidade: Sentry (erros), Axiom (logs), PostHog (analytics).",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./posthog": {
      "import": "./src/posthog.tsx",
      "types": "./src/posthog.tsx"
    },
    "./sentry-init": {
      "import": "./src/sentry-init.ts",
      "types": "./src/sentry-init.ts"
    },
    "./next-config": {
      "import": "./src/next-config.ts",
      "types": "./src/next-config.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.0.0",
    "next-axiom": "^1.5.0",
    "posthog-js": "^1.212.0",
    "posthog-node": "^4.0.0"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@colheita/config": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "next": "15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vitest": "2.1.4"
  }
}
