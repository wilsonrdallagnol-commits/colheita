# --- Runtime
NODE_ENV=development

# --- Supabase (local: usa valores do docker-compose)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# --- Postgres direto (Drizzle migrations + dev local)
# Em dev: porta 5432 direto.
# Em produção: aponte DATABASE_URL para Supavisor transaction mode (porta 6543)
# e DATABASE_URL_DIRECT para a porta 5432 (apenas pra migrations).
DATABASE_URL=postgresql://postgres:DEV_ONLY_postgres_password@localhost:54322/postgres
DATABASE_URL_DIRECT=postgresql://postgres:DEV_ONLY_postgres_password@localhost:54322/postgres

# --- Anthropic (RAG agronômico, agentes)
ANTHROPIC_API_KEY=sk-ant-...

# --- Voyage AI (embeddings semânticos — primário, recomendado pela Anthropic)
# Obtenha em: https://dash.voyageai.com
# Se não configurado, o sistema usa OPENAI_API_KEY como fallback.
VOYAGE_API_KEY=pa-...

# --- OpenAI (embeddings — fallback se VOYAGE_API_KEY não configurado)
OPENAI_API_KEY=sk-...

# --- Google Gemini (geração de imagens via Nano Banana Pro)
# Pega em: https://aistudio.google.com/apikey
# Usado por @colheita/image-gen — endpoint admin /api/imagens/gerar.
# Modelo padrão: gemini-2.5-flash-image-preview (~$0.04 por imagem).
GEMINI_API_KEY=AIzaSy...

# --- Supabase (server-side, sem NEXT_PUBLIC_ — usado pelos embed jobs e vector retriever)
# Mesmo valor de NEXT_PUBLIC_SUPABASE_URL mas sem expor ao browser.
SUPABASE_URL=http://localhost:54321

# --- Resend (emails transacionais)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@colheita.arghoagrosciences.com
RESEND_NOTIFY_EMAIL=pedidos@argho.com.br
RESEND_TENANT_NAME=Argho Distribuidora

# --- Trigger.dev (background jobs)
TRIGGER_SECRET_KEY=tr_dev_...
TRIGGER_PROJECT_REF=

# --- Sentry (observabilidade)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=argho
SENTRY_PROJECT=colheita

# --- Axiom (logs estruturados)
AXIOM_TOKEN=
AXIOM_DATASET=colheita

# --- PostHog (analytics produto + feature flags)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App URLs (multi-app)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_ACADEMIA_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3003

# --- Integrações externas
# Safra: segredo HMAC-SHA256 para verificação de webhooks (header X-Safra-Signature)
SAFRA_WEBHOOK_SECRET=
